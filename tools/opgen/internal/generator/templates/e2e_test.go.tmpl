			return cxsdk.IsNotFound(cxsdk.NewAPIError(httpResp, err))
		}, time.Minute, time.Second).Should(BeTrue())
	})
})

// remove{{.Kind}}Generated is the backstop of a test that fails. It waits until the operator has
// deleted the {{.Kind}}. When the operator does not, it deletes the {{.Kind}} through the API. A
// {{.Kind}} that is already gone is a success.
func remove{{.Kind}}Generated(ctx context.Context, apiClient *{{.SDKAlias}}.{{.Client}}, id {{if .IDBits}}{{.IDGoType}}{{else}}string{{end}}) {
	deadline := time.Now().Add(time.Minute)
	for time.Now().Before(deadline) {
		_, httpResp, err := {{$.GetCall "id"}}.Execute()
		if cxsdk.IsNotFound(cxsdk.NewAPIError(httpResp, err)) {
			return
		}
		time.Sleep(time.Second)
	}
	_, httpResp, err := apiClient.{{.DeleteMethod}}(ctx, id).Execute()
	if apiErr := cxsdk.NewAPIError(httpResp, err); !cxsdk.IsNotFound(apiErr) {
		Expect(apiErr).To(Succeed())
	}
}
{{- if .GetFromList}}

// {{lowerFirst .Kind}}GetFromList reads the {{.Kind}} with the id from the List: no call of the API
// reads one {{.Kind}} by its id. A {{.Kind}} that the List does not hold is a 404, as a Get would
// answer.
type {{lowerFirst .Kind}}GetFromList struct {
	ctx       context.Context
	apiClient *{{.SDKAlias}}.{{.Client}}
	id        {{if .IDBits}}{{.IDGoType}}{{else}}string{{end}}
}

func (g {{lowerFirst .Kind}}GetFromList) Execute() (*{{.SDKAlias}}.{{.GetItemType}}, *http.Response, error) {
	list, httpResp, err := g.apiClient.{{.GetMethod}}(g.ctx).Execute()
	if err != nil {
		return nil, httpResp, err
	}
	for i := range list.{{.GetListField}} {
		if {{if .IDValue}}list.{{.GetListField}}[i].{{.IDField}}{{else}}ptr.Deref(list.{{.GetListField}}[i].{{.IDField}}, {{if .IDBits}}0{{else}}""{{end}}){{end}} == g.id {
			return &list.{{.GetListField}}[i], httpResp, nil
		}
	}
	return nil, &http.Response{StatusCode: http.StatusNotFound}, {{lowerFirst .Kind}}NotInList{}
}

// {{lowerFirst .Kind}}NotInList is the error of a {{.Kind}} that the List does not hold. Its body is
// the one of a 404 of the API, so cxsdk.IsNotFound reads it as a missing {{.Kind}}.
type {{lowerFirst .Kind}}NotInList struct{}

func ({{lowerFirst .Kind}}NotInList) Error() string { return "the {{.Kind}} is not in the List" }

func ({{lowerFirst .Kind}}NotInList) Body() []byte {
	return []byte(`{"code":404,"message":"Not Found: the {{.Kind}} is not in the List"}`)
}

func ({{lowerFirst .Kind}}NotInList) Model() interface{} { return nil }
