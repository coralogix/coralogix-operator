		apiClient = newOpenAPIClientSet().{{.Accessor}}()
		fullName = uniqueName("e2e-{{.Lower}}")
		minimalName = uniqueName("e2e-{{.Lower}}-min")
{{- range .E2E.Fixtures}}
		{
			fixture := &{{.Alias}}.{{.Kind}}{ObjectMeta: metav1.ObjectMeta{Name: fullName + "{{.Suffix}}", Namespace: testNamespace}}
			decoder := json.NewDecoder(strings.NewReader(strings.ReplaceAll({{if $.E2E.Env}}expand{{$.Kind}}Env({{.SpecJSON}}){{else}}{{.SpecJSON}}{{end}}, "@{run}", fullName)))
			decoder.DisallowUnknownFields()
			Expect(decoder.Decode(&fixture.Spec)).To(Succeed())
			Expect(crClient.Create(ctx, fixture)).To(Succeed())
			DeferCleanup(func(ctx context.Context) { _ = crClient.Delete(ctx, fixture) })
			Eventually(func(g Gomega) {
				current := &{{.Alias}}.{{.Kind}}{}
				g.Expect(crClient.Get(ctx, types.NamespacedName{Name: fixture.Name, Namespace: testNamespace}, current)).To(Succeed())
				g.Expect(current.Status.{{.StatusField}}).NotTo(BeNil())
			}, time.Minute, time.Second).Should(Succeed())
		}
{{- end}}
		DeferCleanup(func(ctx context.Context) {
			for _, name := range []string{fullName, minimalName} {
				_ = crClient.Delete(ctx, &coralogixv1alpha1.{{.Kind}}{ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: testNamespace}})
			}
