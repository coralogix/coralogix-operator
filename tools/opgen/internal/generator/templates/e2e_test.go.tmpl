{{- if and .E2E.Update .E2E.Update.Skip}}

	// No update step: {{.E2E.Update.Skip}}
{{- else}}

	It("updates the {{.Kind}}", func(ctx context.Context) {
		current := &coralogixv1alpha1.{{.Kind}}{}
		Expect(crClient.Get(ctx, types.NamespacedName{Name: fullName, Namespace: testNamespace}, current)).To(Succeed())
		updated := current.DeepCopy()
{{- with .E2E.Update}}
		updated.Spec.{{.Field}} = {{.Set}}
		Expect(crClient.Patch(ctx, updated, client.MergeFrom(current))).To(Succeed())

		By("Reading the change from the API")
		Eventually(func(g Gomega) {
			got, httpResp, err := {{$.GetCall "fullID"}}.Execute()
			g.Expect(cxsdk.NewAPIError(httpResp, err)).To(Succeed())
{{- if $.GetResponseField}}
			g.Expect(got).NotTo(BeNil())
{{- if $.GetByIDs}}
			g.Expect(got.{{$.GetResponseField}}).To(HaveLen(1))
			g.Expect({{$.GetItem}}.{{$.IDField}}).To(Equal({{if not $.IDValue}}&{{end}}fullID))
{{- else if not $.GetResponseValue}}
			g.Expect(got.{{$.GetResponseField}}).NotTo(BeNil())
{{- end}}
{{- end}}
{{- range .NotNil}}
			g.Expect({{.}}).NotTo(BeNil())
{{- end}}
{{- if .Check}}
			// The CR holds the {{$.Kind}} as JSON text: compare {{.Check}} of the new text and the response.
			var gotFields, wantFields map[string]any
			raw, err := json.Marshal({{$.GetItem}})
			g.Expect(err).NotTo(HaveOccurred())
			g.Expect(json.Unmarshal(raw, &gotFields)).To(Succeed())
			g.Expect(json.Unmarshal([]byte({{.Want}}), &wantFields)).To(Succeed())
			g.Expect(gotFields[{{printf "%q" .Check}}]).To(Equal(wantFields[{{printf "%q" .Check}}]))
{{- else}}
{{- if .ListGet}}
			matched := false
			for _, item := range {{.ListGet}} {
				if {{.Match}} {
					g.Expect({{.Got}}).To(Equal({{.Want}}))
					matched = true
					break
				}
			}
			g.Expect(matched).To(BeTrue(), "the updated list item is missing")
{{- else}}
			g.Expect({{.Got}}).To(Equal({{.Want}}))
{{- end}}
{{- end}}
		}, time.Minute, time.Second).Should(Succeed())
{{- end}}
	})
{{- end}}

	It("deletes the {{.Kind}}", func(ctx context.Context) {
		Expect(crClient.Delete(ctx, full)).To(Succeed())

		By("Waiting until the API no longer finds the {{.Kind}}")
		Eventually(func() bool {
