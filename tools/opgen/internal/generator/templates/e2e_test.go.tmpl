	})

	It("creates a {{.Kind}} with every field", func(ctx context.Context) {
		full = new{{.Kind}}Generated(fullName, {{lowerFirst .Kind}}FullSpec)
		Expect(crClient.Create(ctx, full)).To(Succeed())
