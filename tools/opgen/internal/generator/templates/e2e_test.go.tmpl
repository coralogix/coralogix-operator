// The coverage steps send an accepted enum value and a oneOf arm that the full spec does not. Each
// step creates all its copies, waits until each is synced, reads each from the API, and deletes each.
var {{lowerFirst .Kind}}CoverageSteps = [][]string{
{{- range .E2E.StepJSON}}
	{
{{- range .}}
		{{.}},
{{- end}}
	},
{{- end}}
}

var _ = Describe("{{.Kind}} (coverage)", Ordered{{if .E2E.Serial}}, Serial{{end}}, Label("coverage"), func() {
	var (
		crClient  client.Client
		apiClient *{{.SDKAlias}}.{{.Client}}
		base      string
	)

	BeforeAll(func() {
		crClient = ClientsInstance.GetControllerRuntimeClient()
		apiClient = newOpenAPIClientSet().{{.Accessor}}()
		base = uniqueName("e2e-{{.Lower}}-cov")
	})

	for i, step := range {{lowerFirst .Kind}}CoverageSteps {
		It(fmt.Sprintf("sends step %d", i+1), Label(fmt.Sprintf("coverage-{{.Lower}}-%d", i+1)), func(ctx context.Context) {
			var (
				objects []client.Object
				names   []string
				ids     []{{if .IDBits}}{{.IDGoType}}{{else}}string{{end}}
			)
			DeferCleanup(func(ctx context.Context) {
				for _, object := range objects {
					_ = crClient.Delete(ctx, object)
				}
				for _, id := range ids {
					remove{{.Kind}}Generated(ctx, apiClient, id)
				}
			})

			for j, spec := range step {
				name := fmt.Sprintf("%s-%d-%d", base, i+1, j+1)
{{- range .E2E.Fixtures}}
				{
					fixture := &coralogixv1alpha1.{{.Kind}}{ObjectMeta: metav1.ObjectMeta{Name: name + "{{.Suffix}}", Namespace: testNamespace}}
					decoder := json.NewDecoder(strings.NewReader(strings.ReplaceAll({{.SpecJSON}}, "@{run}", name)))
					decoder.DisallowUnknownFields()
					Expect(decoder.Decode(&fixture.Spec)).To(Succeed())
					Expect(crClient.Create(ctx, fixture)).To(Succeed())
					objects = append(objects, fixture)
					Eventually(func(g Gomega) {
						current := &coralogixv1alpha1.{{.Kind}}{}
						g.Expect(crClient.Get(ctx, types.NamespacedName{Name: fixture.Name, Namespace: testNamespace}, current)).To(Succeed())
						g.Expect(current.Status.{{.StatusField}}).NotTo(BeNil())
					}, time.Minute, time.Second).Should(Succeed())
				}
{{- end}}
				cr := new{{.Kind}}Generated(name, spec)
				Expect(crClient.Create(ctx, cr)).To(Succeed())
				objects = append(objects, cr)
				names = append(names, name)
			}

			By("Waiting until every copy is synced and the API returns it")
			for _, name := range names {
				id := waitFor{{.Kind}}Generated(ctx, crClient, name)
				ids = append(ids, id)
				Eventually(func(g Gomega) {
					_, httpResp, err := apiClient.{{.GetMethod}}(ctx, id).Execute()
					g.Expect(cxsdk.NewAPIError(httpResp, err)).To(Succeed())
				}, time.Minute, time.Second).Should(Succeed())
			}

			By("Deleting every copy")
			for _, object := range objects {
				Expect(crClient.Delete(ctx, object)).To(Succeed())
			}
			for _, id := range ids {
				Eventually(func() bool {
					_, httpResp, err := apiClient.{{.GetMethod}}(ctx, id).Execute()
					return cxsdk.IsNotFound(cxsdk.NewAPIError(httpResp, err))
				}, time.Minute, time.Second).Should(BeTrue())
			}
		})
	}
})
