	It("updates the {{.Kind}}", func(ctx context.Context) {
		current := &coralogixv1alpha1.{{.Kind}}{}
		Expect(crClient.Get(ctx, types.NamespacedName{Name: fullName, Namespace: testNamespace}, current)).To(Succeed())
		updated := current.DeepCopy()
{{- with .E2E.Update}}
		updated.Spec.{{.Field}} = {{.Set}}
		Expect(crClient.Patch(ctx, updated, client.MergeFrom(current))).To(Succeed())

		By("Reading the change from the API")
		Eventually(func(g Gomega) {
			got, httpResp, err := apiClient.{{$.GetMethod}}(ctx, fullID).Execute()
			g.Expect(cxsdk.NewAPIError(httpResp, err)).To(Succeed())
{{- if $.GetResponseField}}
			g.Expect(got).NotTo(BeNil())
{{- if not $.GetResponseValue}}
			g.Expect(got.{{$.GetResponseField}}).NotTo(BeNil())
{{- end}}
{{- end}}
{{- range .NotNil}}
			g.Expect({{.}}).NotTo(BeNil())
{{- end}}
			g.Expect({{.Got}}).To(Equal({{.Want}}))
		}, time.Minute, time.Second).Should(Succeed())
{{- end}}
	})

	It("deletes the {{.Kind}}", func(ctx context.Context) {
		Expect(crClient.Delete(ctx, full)).To(Succeed())

		By("Waiting until the API no longer finds the {{.Kind}}")
		Eventually(func() bool {
			_, httpResp, err := apiClient.{{.GetMethod}}(ctx, fullID).Execute()
