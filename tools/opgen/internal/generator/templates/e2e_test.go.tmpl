	It("creates and deletes a {{.Kind}} with only the required fields", func(ctx context.Context) {
		minimal := new{{.Kind}}Generated(minimalName, {{lowerFirst .Kind}}MinimalSpec)
		Expect(crClient.Create(ctx, minimal)).To(Succeed())
