			Expect(decoder.Decode(&fixture.Spec)).To(Succeed())
			Expect(crClient.Create(ctx, fixture)).To(Succeed())
			DeferCleanup(func(ctx context.Context) { _ = crClient.Delete(ctx, fixture) })
			Eventually(func(g Gomega) {
