		createdIDs = append(createdIDs, fullID)

		By("Reading the {{.Kind}} from the API")
		Eventually(func(g Gomega) {
			_, httpResp, err := {{$.GetCall "fullID"}}.Execute()
			g.Expect(cxsdk.NewAPIError(httpResp, err)).To(Succeed())
