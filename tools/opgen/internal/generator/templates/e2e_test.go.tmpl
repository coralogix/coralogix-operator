		// createdIDs holds the API id of every {{.Kind}} that a step created, for the backstop in the cleanup.
		createdIDs []{{if .IDBits}}{{.IDGoType}}{{else}}string{{end}}
	)

	BeforeAll(func{{if or .E2E.Fixtures .Requires}}(ctx context.Context){{else}}(){{end}} {
{{- if .Requires}}
		ensure{{.Requires}}EnabledGenerated(ctx)
{{- end}}
{{- if $.E2E.Env}}
		require{{$.Kind}}Env()
{{- end}}
