// remove{{.Kind}}Generated is the backstop of a test that fails. It waits until the operator has
// deleted the {{.Kind}}. When the operator does not, it deletes the {{.Kind}} through the API. A
// {{.Kind}} that is already gone is a success.
func remove{{.Kind}}Generated(ctx context.Context, apiClient *{{.SDKAlias}}.{{.Client}}, id {{if .IDBits}}{{.IDGoType}}{{else}}string{{end}}) {
	deadline := time.Now().Add(time.Minute)
	for time.Now().Before(deadline) {
		_, httpResp, err := apiClient.{{.GetMethod}}(ctx, id).Execute()
		if cxsdk.IsNotFound(cxsdk.NewAPIError(httpResp, err)) {
			return
		}
		time.Sleep(time.Second)
	}
	_, httpResp, err := apiClient.{{.DeleteMethod}}(ctx, id).Execute()
	if apiErr := cxsdk.NewAPIError(httpResp, err); !cxsdk.IsNotFound(apiErr) {
		Expect(apiErr).To(Succeed())
	}
}

// new{{.Kind}}Generated returns a {{.Kind}} with the spec that the JSON holds.
func new{{.Kind}}Generated(name, spec string) *coralogixv1alpha1.{{.Kind}} {
	cr := &coralogixv1alpha1.{{.Kind}}{ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: testNamespace}}
	{{- range .E2E.Substitutions}}
	spec = strings.ReplaceAll(spec, {{printf "%q" .From}}, strings.ReplaceAll({{printf "%q" .To}}, "@{run}", name))
	{{- end}}
	decoder := json.NewDecoder(strings.NewReader(spec))
	decoder.DisallowUnknownFields()
	Expect(decoder.Decode(&cr.Spec)).To(Succeed())
{{- with .E2E.NameField}}
	cr.Spec.{{.}} = {{if $.E2E.NamePtr}}ptr.To(name){{else}}name{{end}}
{{- end}}
	return cr
}

// waitFor{{.Kind}}Generated waits until the {{.Kind}} is synced, and returns its {{if .IDBits}}API {{end}}id.
func waitFor{{.Kind}}Generated(ctx context.Context, crClient client.Client, name string) {{if .IDBits}}{{.IDGoType}}{{else}}string{{end}} {
	var id string
	Eventually(func(g Gomega) {
		cr := &coralogixv1alpha1.{{.Kind}}{}
		g.Expect(crClient.Get(ctx, types.NamespacedName{Name: name, Namespace: testNamespace}, cr)).To(Succeed())
		g.Expect(meta.IsStatusConditionTrue(cr.Status.Conditions, utils.ConditionTypeRemoteSynced)).To(BeTrue())
		g.Expect(cr.Status.ID).NotTo(BeNil())
		id = *cr.Status.ID
	}, time.Minute, time.Second).Should(Succeed())
{{- if .IDBits}}
	parsedID, err := strconv.ParseInt(id, 10, {{.IDBits}})
	Expect(err).NotTo(HaveOccurred())
	return {{.IDGoType}}(parsedID)
{{- else}}
	return id
{{- end}}
}
