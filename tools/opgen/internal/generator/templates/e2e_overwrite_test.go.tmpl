{{with .E2E}}{{if .Omit}}// The full spec sets compatible fields. The minimal spec sets only the required fields.{{else}}// The full spec sets every field. The minimal spec sets only the required fields.{{end}}{{end}}
// Each write replaces the whole list of the account, so the test runs alone.
const (
	{{lowerFirst .Kind}}FullSpec    = {{.E2E.FullJSON}}
	{{lowerFirst .Kind}}MinimalSpec = {{.E2E.MinimalJSON}}
)

var _ = Describe("{{.Kind}} (generated)", Ordered, Serial, func() {
	var (
		crClient    client.Client
		apiClient   *{{.SDKAlias}}.{{.Client}}
		fullName    string
		minimalName string
		full        *coralogixv1alpha1.{{.Kind}}
	)

	BeforeAll(func{{if .E2E.Fixtures}}(ctx context.Context){{else}}(){{end}} {
		crClient = ClientsInstance.GetControllerRuntimeClient()
		apiClient = newOpenAPIClientSet().{{.Accessor}}()
		fullName = uniqueName("e2e-{{.Lower}}")
		minimalName = uniqueName("e2e-{{.Lower}}-min")
{{- range .E2E.Fixtures}}
		{
			fixture := &coralogixv1alpha1.{{.Kind}}{ObjectMeta: metav1.ObjectMeta{Name: fullName + "{{.Suffix}}", Namespace: testNamespace}}
			decoder := json.NewDecoder(strings.NewReader(strings.ReplaceAll({{.SpecJSON}}, "@{run}", fullName)))
			decoder.DisallowUnknownFields()
			Expect(decoder.Decode(&fixture.Spec)).To(Succeed())
			Expect(crClient.Create(ctx, fixture)).To(Succeed())
			DeferCleanup(func(ctx context.Context) { _ = crClient.Delete(ctx, fixture) })
			Eventually(func(g Gomega) {
				current := &coralogixv1alpha1.{{.Kind}}{}
				g.Expect(crClient.Get(ctx, types.NamespacedName{Name: fixture.Name, Namespace: testNamespace}, current)).To(Succeed())
				g.Expect(current.Status.{{.StatusField}}).NotTo(BeNil())
			}, time.Minute, time.Second).Should(Succeed())
		}
{{- end}}
		DeferCleanup(func(ctx context.Context) {
			for _, name := range []string{fullName, minimalName} {
				_ = crClient.Delete(ctx, &coralogixv1alpha1.{{.Kind}}{ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: testNamespace}})
			}
			for _, name := range []string{fullName, minimalName} {
				remove{{.Kind}}Generated(ctx, apiClient, name)
			}
		})
	})

	It("creates a {{.Kind}} with every field", func(ctx context.Context) {
		full = new{{.Kind}}Generated(fullName, {{lowerFirst .Kind}}FullSpec)
		Expect(crClient.Create(ctx, full)).To(Succeed())
		waitFor{{.Kind}}Generated(ctx, crClient, fullName)

		By("Finding the item in the list of the API")
		Eventually(func(g Gomega) {
			g.Expect(find{{.Kind}}Generated(ctx, g, apiClient, fullName)).NotTo(BeNil())
		}, time.Minute, time.Second).Should(Succeed())
	})
{{with .E2E.Overwrite}}
	It("updates the {{$.Kind}}", func(ctx context.Context) {
		current := &coralogixv1alpha1.{{$.Kind}}{}
		Expect(crClient.Get(ctx, types.NamespacedName{Name: fullName, Namespace: testNamespace}, current)).To(Succeed())
		updated := current.DeepCopy()
		updated.Spec.{{.List}}[0].{{.Field}} = {{.Set}}
		Expect(crClient.Patch(ctx, updated, client.MergeFrom(current))).To(Succeed())

		By("Reading the change from the API")
		Eventually(func(g Gomega) {
			item := find{{$.Kind}}Generated(ctx, g, apiClient, fullName)
			g.Expect(item).NotTo(BeNil())
			g.Expect({{.Got}}).To(Equal({{.Want}}))
		}, time.Minute, time.Second).Should(Succeed())
	})
{{end}}
	It("deletes the {{.Kind}}", func(ctx context.Context) {
		Expect(crClient.Delete(ctx, full)).To(Succeed())

		By("Waiting until the list of the API no longer has the item")
		Eventually(func(g Gomega) {
			g.Expect(find{{.Kind}}Generated(ctx, g, apiClient, fullName)).To(BeNil())
		}, time.Minute, time.Second).Should(Succeed())
	})

	It("creates and deletes a {{.Kind}} with only the required fields", func(ctx context.Context) {
		minimal := new{{.Kind}}Generated(minimalName, {{lowerFirst .Kind}}MinimalSpec)
		Expect(crClient.Create(ctx, minimal)).To(Succeed())
		waitFor{{.Kind}}Generated(ctx, crClient, minimalName)
		Eventually(func(g Gomega) {
			g.Expect(find{{.Kind}}Generated(ctx, g, apiClient, minimalName)).NotTo(BeNil())
		}, time.Minute, time.Second).Should(Succeed())

		Expect(crClient.Delete(ctx, minimal)).To(Succeed())
		Eventually(func(g Gomega) {
			g.Expect(find{{.Kind}}Generated(ctx, g, apiClient, minimalName)).To(BeNil())
		}, time.Minute, time.Second).Should(Succeed())
	})
})

// remove{{.Kind}}Generated is the backstop of a test that fails. It waits until the operator has
// removed the item with the name from the list of the API. When the operator does not, it writes the
// list empty through the API. A list that is already empty is a success.
func remove{{.Kind}}Generated(ctx context.Context, apiClient *{{.SDKAlias}}.{{.Client}}, name string) {
	deadline := time.Now().Add(time.Minute)
	for time.Now().Before(deadline) {
		if !has{{.Kind}}Generated(ctx, apiClient, name) {
			return
		}
		time.Sleep(time.Second)
	}
	body := {{.SDKAlias}}.{{.UpdateBody}}{
{{- range .WriteFields}}
		{{.Field}}: {{.Empty}},
{{- end}}
	}
	_, httpResp, err := apiClient.{{.UpdateMethod}}(ctx).{{.UpdateSetter}}(body).Execute()
	if apiErr := cxsdk.NewAPIError(httpResp, err); !cxsdk.IsNotFound(apiErr) {
		Expect(apiErr).To(Succeed())
	}
}

// has{{.Kind}}Generated reports whether the list of the API has an item of the custom resource with
// the name: an item named name, or name with a position, such as name-2. A failed read counts as
// yes, so the backstop keeps waiting.
func has{{.Kind}}Generated(ctx context.Context, apiClient *{{.SDKAlias}}.{{.Client}}, name string) bool {
	got, httpResp, err := apiClient.{{.GetMethod}}(ctx).Execute()
	if cxsdk.NewAPIError(httpResp, err) != nil || got == nil {
		return true
	}
{{- with .E2E.Overwrite}}
	for i := range got.{{.ListGet}} {
		if item := {{if .NameGetPtr}}ptr.Deref(got.{{.ListGet}}[i].{{.NameGet}}, ""){{else}}got.{{.ListGet}}[i].{{.NameGet}}{{end}}; item == name || strings.HasPrefix(item, name+"-") {
			return true
		}
	}
{{- end}}
	return false
}

// new{{.Kind}}Generated returns a {{.Kind}} with the spec that the JSON holds. Its first item is
// named after the custom resource, so that the test can find it in the list of the API. Each later
// item gets the name with its position, such as name-2: the API rejects two items with one name.
func new{{.Kind}}Generated(name, spec string) *coralogixv1alpha1.{{.Kind}} {
	cr := &coralogixv1alpha1.{{.Kind}}{ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: testNamespace}}
	{{- range .E2E.Substitutions}}
	{{- if .Env}}
	{
		value := os.Getenv({{printf "%q" .Env}})
		Expect(value).NotTo(BeEmpty(), "set {{.Env}} for the e2e test of {{$.Kind}}")
		spec = strings.ReplaceAll(spec, {{printf "%q" .From}}, value)
	}
	{{- else}}
	spec = strings.ReplaceAll(spec, {{printf "%q" .From}}, strings.ReplaceAll({{printf "%q" .To}}, "@{run}", name))
	{{- end}}
	{{- end}}
	decoder := json.NewDecoder(strings.NewReader(spec))
	decoder.DisallowUnknownFields()
	Expect(decoder.Decode(&cr.Spec)).To(Succeed())
{{- with .E2E.Overwrite}}
	for i := range cr.Spec.{{.List}} {
		itemName := name
		if i > 0 {
			itemName = fmt.Sprintf("%s-%d", name, i+1)
		}
		cr.Spec.{{.List}}[i].{{.Name}} = {{if .NamePtr}}ptr.To(itemName){{else}}itemName{{end}}
	}
{{- end}}
	return cr
}

// waitFor{{.Kind}}Generated waits until the {{.Kind}} is synced.
func waitFor{{.Kind}}Generated(ctx context.Context, crClient client.Client, name string) {
	Eventually(func(g Gomega) {
		cr := &coralogixv1alpha1.{{.Kind}}{}
		g.Expect(crClient.Get(ctx, types.NamespacedName{Name: name, Namespace: testNamespace}, cr)).To(Succeed())
		g.Expect(meta.IsStatusConditionTrue(cr.Status.Conditions, utils.ConditionTypeRemoteSynced)).To(BeTrue())
	}, time.Minute, time.Second).Should(Succeed())
}
{{with .E2E.Overwrite}}
// find{{$.Kind}}Generated returns the item of the list of the API with the name, nil when it has none.
func find{{$.Kind}}Generated(ctx context.Context, g Gomega, apiClient *{{$.SDKAlias}}.{{$.Client}}, name string) *{{$.SDKAlias}}.{{$.ItemGetType}} {
	got, httpResp, err := apiClient.{{$.GetMethod}}(ctx).Execute()
	g.Expect(cxsdk.NewAPIError(httpResp, err)).To(Succeed())
	g.Expect(got).NotTo(BeNil())
	for i := range got.{{.ListGet}} {
		if {{if .NameGetPtr}}ptr.Deref(got.{{.ListGet}}[i].{{.NameGet}}, ""){{else}}got.{{.ListGet}}[i].{{.NameGet}}{{end}} == name {
			return &got.{{.ListGet}}[i]
		}
	}
	return nil
}
{{- end}}
{{- if .E2E.StepJSON}}

// The coverage steps send an accepted enum value and a oneOf arm that the full spec does not. Each
// write replaces the whole list of the account, so the copies run one at a time: each copy is
// created, synced, found in the list of the API, and deleted before the next one.
var {{lowerFirst .Kind}}CoverageSteps = [][]string{
{{- range .E2E.StepJSON}}
	{
{{- range .}}
		{{.}},
{{- end}}
	},
{{- end}}
}

var _ = Describe("{{.Kind}} (coverage)", Ordered, Serial, Label("coverage"), func() {
	var (
		crClient  client.Client
		apiClient *{{.SDKAlias}}.{{.Client}}
		base      string
	)

	BeforeAll(func() {
		crClient = ClientsInstance.GetControllerRuntimeClient()
		apiClient = newOpenAPIClientSet().{{.Accessor}}()
		base = uniqueName("e2e-{{.Lower}}-cov")
	})

	for i, step := range {{lowerFirst .Kind}}CoverageSteps {
		It(fmt.Sprintf("sends step %d", i+1), Label(fmt.Sprintf("coverage-{{.Lower}}-%d", i+1)), func(ctx context.Context) {
			for j, spec := range step {
				name := fmt.Sprintf("%s-%d-%d", base, i+1, j+1)
				var objects []client.Object
				DeferCleanup(func(ctx context.Context) {
					for _, object := range objects {
						_ = crClient.Delete(ctx, object)
					}
					remove{{$.Kind}}Generated(ctx, apiClient, name)
				})
{{- range .E2E.Fixtures}}
				{
					fixture := &coralogixv1alpha1.{{.Kind}}{ObjectMeta: metav1.ObjectMeta{Name: name + "{{.Suffix}}", Namespace: testNamespace}}
					decoder := json.NewDecoder(strings.NewReader(strings.ReplaceAll({{.SpecJSON}}, "@{run}", name)))
					decoder.DisallowUnknownFields()
					Expect(decoder.Decode(&fixture.Spec)).To(Succeed())
					Expect(crClient.Create(ctx, fixture)).To(Succeed())
					objects = append(objects, fixture)
					Eventually(func(g Gomega) {
						current := &coralogixv1alpha1.{{.Kind}}{}
						g.Expect(crClient.Get(ctx, types.NamespacedName{Name: fixture.Name, Namespace: testNamespace}, current)).To(Succeed())
						g.Expect(current.Status.{{.StatusField}}).NotTo(BeNil())
					}, time.Minute, time.Second).Should(Succeed())
				}
{{- end}}
				cr := new{{.Kind}}Generated(name, spec)
				Expect(crClient.Create(ctx, cr)).To(Succeed())
				objects = append(objects, cr)

				By(fmt.Sprintf("Waiting until copy %d is synced and the list of the API has it", j+1))
				waitFor{{.Kind}}Generated(ctx, crClient, name)
				Eventually(func(g Gomega) {
					g.Expect(find{{.Kind}}Generated(ctx, g, apiClient, name)).NotTo(BeNil())
				}, time.Minute, time.Second).Should(Succeed())

				By(fmt.Sprintf("Deleting copy %d", j+1))
				for _, object := range objects {
					Expect(crClient.Delete(ctx, object)).To(Succeed())
				}
				Eventually(func(g Gomega) {
					g.Expect(find{{.Kind}}Generated(ctx, g, apiClient, name)).To(BeNil())
				}, time.Minute, time.Second).Should(Succeed())
			}
		})
	}
})
