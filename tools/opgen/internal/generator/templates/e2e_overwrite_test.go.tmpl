{{with .E2E}}{{if .Omit}}// The full spec sets compatible fields. The minimal spec sets only the required fields.{{else}}// The full spec sets every field. The minimal spec sets only the required fields.{{end}}{{end}}
// Each write replaces the whole list of the account, so the test runs alone.
const (
	{{lowerFirst .Kind}}FullSpec    = {{.E2E.FullJSON}}
	{{lowerFirst .Kind}}MinimalSpec = {{.E2E.MinimalJSON}}
)

var _ = Describe("{{.Kind}} (generated)", Ordered, Serial, func() {
	var (
		crClient    client.Client
		apiClient   *{{.SDKAlias}}.{{.Client}}
		fullName    string
		minimalName string
		full        *coralogixv1alpha1.{{.Kind}}
	)

	BeforeAll(func() {
		crClient = ClientsInstance.GetControllerRuntimeClient()
		apiClient = newOpenAPIClientSet().{{.Accessor}}()
		fullName = uniqueName("e2e-{{.Lower}}")
		minimalName = uniqueName("e2e-{{.Lower}}-min")
		DeferCleanup(func(ctx context.Context) {
			for _, name := range []string{fullName, minimalName} {
				_ = crClient.Delete(ctx, &coralogixv1alpha1.{{.Kind}}{ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: testNamespace}})
			}
		})
	})

	It("creates a {{.Kind}} with every field", func(ctx context.Context) {
		full = new{{.Kind}}Generated(fullName, {{lowerFirst .Kind}}FullSpec)
		Expect(crClient.Create(ctx, full)).To(Succeed())
		waitFor{{.Kind}}Generated(ctx, crClient, fullName)

		By("Finding the item in the list of the API")
		Eventually(func(g Gomega) {
			g.Expect(find{{.Kind}}Generated(ctx, g, apiClient, fullName)).NotTo(BeNil())
		}, time.Minute, time.Second).Should(Succeed())
	})
{{with .E2E.Overwrite}}
	It("updates the {{$.Kind}}", func(ctx context.Context) {
		current := &coralogixv1alpha1.{{$.Kind}}{}
		Expect(crClient.Get(ctx, types.NamespacedName{Name: fullName, Namespace: testNamespace}, current)).To(Succeed())
		updated := current.DeepCopy()
		updated.Spec.{{.List}}[0].{{.Field}} = {{.Set}}
		Expect(crClient.Patch(ctx, updated, client.MergeFrom(current))).To(Succeed())

		By("Reading the change from the API")
		Eventually(func(g Gomega) {
			item := find{{$.Kind}}Generated(ctx, g, apiClient, fullName)
			g.Expect(item).NotTo(BeNil())
			g.Expect({{.Got}}).To(Equal({{.Want}}))
		}, time.Minute, time.Second).Should(Succeed())
	})
{{end}}
	It("deletes the {{.Kind}}", func(ctx context.Context) {
		Expect(crClient.Delete(ctx, full)).To(Succeed())

		By("Waiting until the list of the API no longer has the item")
		Eventually(func(g Gomega) {
			g.Expect(find{{.Kind}}Generated(ctx, g, apiClient, fullName)).To(BeNil())
		}, time.Minute, time.Second).Should(Succeed())
	})

	It("creates and deletes a {{.Kind}} with only the required fields", func(ctx context.Context) {
		minimal := new{{.Kind}}Generated(minimalName, {{lowerFirst .Kind}}MinimalSpec)
		Expect(crClient.Create(ctx, minimal)).To(Succeed())
		waitFor{{.Kind}}Generated(ctx, crClient, minimalName)
		Eventually(func(g Gomega) {
			g.Expect(find{{.Kind}}Generated(ctx, g, apiClient, minimalName)).NotTo(BeNil())
		}, time.Minute, time.Second).Should(Succeed())

		Expect(crClient.Delete(ctx, minimal)).To(Succeed())
		Eventually(func(g Gomega) {
			g.Expect(find{{.Kind}}Generated(ctx, g, apiClient, minimalName)).To(BeNil())
		}, time.Minute, time.Second).Should(Succeed())
	})
})

// new{{.Kind}}Generated returns a {{.Kind}} with the spec that the JSON holds. Its item is named
// after the custom resource, so that the test can find it in the list of the API.
func new{{.Kind}}Generated(name, spec string) *coralogixv1alpha1.{{.Kind}} {
	cr := &coralogixv1alpha1.{{.Kind}}{ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: testNamespace}}
	{{- range .E2E.Substitutions}}
	spec = strings.ReplaceAll(spec, {{printf "%q" .From}}, strings.ReplaceAll({{printf "%q" .To}}, "@{run}", name))
	{{- end}}
	decoder := json.NewDecoder(strings.NewReader(spec))
	decoder.DisallowUnknownFields()
	Expect(decoder.Decode(&cr.Spec)).To(Succeed())
{{- with .E2E.Overwrite}}
	for i := range cr.Spec.{{.List}} {
		cr.Spec.{{.List}}[i].{{.Name}} = {{if .NamePtr}}ptr.To(name){{else}}name{{end}}
	}
{{- end}}
	return cr
}

// waitFor{{.Kind}}Generated waits until the {{.Kind}} is synced.
func waitFor{{.Kind}}Generated(ctx context.Context, crClient client.Client, name string) {
	Eventually(func(g Gomega) {
		cr := &coralogixv1alpha1.{{.Kind}}{}
		g.Expect(crClient.Get(ctx, types.NamespacedName{Name: name, Namespace: testNamespace}, cr)).To(Succeed())
		g.Expect(meta.IsStatusConditionTrue(cr.Status.Conditions, utils.ConditionTypeRemoteSynced)).To(BeTrue())
	}, time.Minute, time.Second).Should(Succeed())
}
{{with .E2E.Overwrite}}
// find{{$.Kind}}Generated returns the item of the list of the API with the name, nil when it has none.
func find{{$.Kind}}Generated(ctx context.Context, g Gomega, apiClient *{{$.SDKAlias}}.{{$.Client}}, name string) *{{$.SDKAlias}}.{{$.ItemGetType}} {
	got, httpResp, err := apiClient.{{$.GetMethod}}(ctx).Execute()
	g.Expect(cxsdk.NewAPIError(httpResp, err)).To(Succeed())
	g.Expect(got).NotTo(BeNil())
	for i := range got.{{.ListGet}} {
		if {{if .NameGetPtr}}ptr.Deref(got.{{.ListGet}}[i].{{.NameGet}}, ""){{else}}got.{{.ListGet}}[i].{{.NameGet}}{{end}} == name {
			return &got.{{.ListGet}}[i]
		}
	}
	return nil
}
{{- end}}
