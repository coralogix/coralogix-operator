{{- range .Enums}}
// {{.Var}} maps each value of the spec to the API value.
var {{.Var}} = map[string]{{.SDKType}}{
{{- range .Values}}
	"{{.Name}}": {{.Const}},
{{- end}}
}

// {{.Func}} returns the API value of a spec value.
func {{.Func}}(value string) ({{.SDKType}}, error) {
	v, ok := {{.Var}}[value]
	if !ok {
		return "", fmt.Errorf("unknown value %q", value)
	}
	return v, nil
}
