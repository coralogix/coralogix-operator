// The API has one {{.Kind}} per team, and no call removes it. Every CR writes the same remote
// {{.Kind}}, so the tests run alone, one CR at a time.

{{if .E2E.Omit}}// The full spec sets compatible fields. The minimal spec sets only the required fields.{{else}}// The full spec sets every field. The minimal spec sets only the required fields.{{end}}
const (
	{{lowerFirst .Kind}}FullSpec    = {{.E2E.FullJSON}}
	{{lowerFirst .Kind}}MinimalSpec = {{.E2E.MinimalJSON}}
)

var _ = Describe("{{.Kind}} (generated)", Ordered, Serial, func() {
	var (
		crClient    client.Client
		apiClient   *{{.SDKAlias}}.{{.Client}}
		fullName    string
		minimalName string
		full        *coralogixv1alpha1.{{.Kind}}
	)

	BeforeAll(func{{if .E2E.Fixtures}}(ctx context.Context){{else}}(){{end}} {
{{- if $.E2E.Env}}
		require{{$.Kind}}Env()
{{- end}}
		crClient = ClientsInstance.GetControllerRuntimeClient()
		apiClient = newOpenAPIClientSet().{{.Accessor}}()
		fullName = uniqueName("e2e-{{.Lower}}")
		minimalName = uniqueName("e2e-{{.Lower}}-min")
{{- range .E2E.Fixtures}}
		{
			fixture := &coralogixv1alpha1.{{.Kind}}{ObjectMeta: metav1.ObjectMeta{Name: fullName + "{{.Suffix}}", Namespace: testNamespace}}
			decoder := json.NewDecoder(strings.NewReader(strings.ReplaceAll({{if $.E2E.Env}}expand{{$.Kind}}Env({{.SpecJSON}}){{else}}{{.SpecJSON}}{{end}}, "@{run}", fullName)))
			decoder.DisallowUnknownFields()
			Expect(decoder.Decode(&fixture.Spec)).To(Succeed())
			Expect(crClient.Create(ctx, fixture)).To(Succeed())
			DeferCleanup(func(ctx context.Context) { _ = crClient.Delete(ctx, fixture) })
			Eventually(func(g Gomega) {
				current := &coralogixv1alpha1.{{.Kind}}{}
				g.Expect(crClient.Get(ctx, types.NamespacedName{Name: fixture.Name, Namespace: testNamespace}, current)).To(Succeed())
				g.Expect(current.Status.{{.StatusField}}).NotTo(BeNil())
			}, time.Minute, time.Second).Should(Succeed())
		}
{{- end}}
		DeferCleanup(func(ctx context.Context) {
			for _, name := range []string{fullName, minimalName} {
				remove{{.Kind}}Generated(ctx, crClient, name)
			}
		})
	})

	It("creates a {{.Kind}} with every field", func(ctx context.Context) {
		full = new{{.Kind}}Generated(fullName, {{lowerFirst .Kind}}FullSpec)
		Expect(crClient.Create(ctx, full)).To(Succeed())
		waitFor{{.Kind}}Generated(ctx, crClient, fullName)

		By("Reading the {{.Kind}} from the API")
		Eventually(func(g Gomega) {
			_, httpResp, err := apiClient.{{.GetMethod}}(ctx).Execute()
			g.Expect(cxsdk.NewAPIError(httpResp, err)).To(Succeed())
		}, time.Minute, time.Second).Should(Succeed())
	})

	It("updates the {{.Kind}}", func(ctx context.Context) {
		current := &coralogixv1alpha1.{{.Kind}}{}
		Expect(crClient.Get(ctx, types.NamespacedName{Name: fullName, Namespace: testNamespace}, current)).To(Succeed())
		updated := current.DeepCopy()
{{- with .E2E.Update}}
		updated.Spec.{{.Field}} = {{.Set}}
		Expect(crClient.Patch(ctx, updated, client.MergeFrom(current))).To(Succeed())

		By("Reading the change from the API")
		Eventually(func(g Gomega) {
			got, httpResp, err := apiClient.{{$.GetMethod}}(ctx).Execute()
			g.Expect(cxsdk.NewAPIError(httpResp, err)).To(Succeed())
{{- if $.GetResponseField}}
			g.Expect(got).NotTo(BeNil())
{{- if not $.GetResponseValue}}
			g.Expect(got.{{$.GetResponseField}}).NotTo(BeNil())
{{- end}}
{{- end}}
{{- range .NotNil}}
			g.Expect({{.}}).NotTo(BeNil())
{{- end}}
			g.Expect({{.Got}}).To(Equal({{.Want}}))
		}, time.Minute, time.Second).Should(Succeed())
{{- end}}
	})

	It("deletes the {{.Kind}}", func(ctx context.Context) {
		Expect(crClient.Delete(ctx, full)).To(Succeed())
		waitFor{{.Kind}}GoneGenerated(ctx, crClient, fullName)
	})

	It("creates and deletes a {{.Kind}} with only the required fields", func(ctx context.Context) {
		minimal := new{{.Kind}}Generated(minimalName, {{lowerFirst .Kind}}MinimalSpec)
		Expect(crClient.Create(ctx, minimal)).To(Succeed())
		waitFor{{.Kind}}Generated(ctx, crClient, minimalName)

		Expect(crClient.Delete(ctx, minimal)).To(Succeed())
		waitFor{{.Kind}}GoneGenerated(ctx, crClient, minimalName)
	})
})

// remove{{.Kind}}Generated is the backstop of a test that fails. It deletes the CR and waits until
// the operator has removed its finalizer. The API cannot remove the {{.Kind}}, so nothing remote is
// left to delete.
func remove{{.Kind}}Generated(ctx context.Context, crClient client.Client, name string) {
	cr := &coralogixv1alpha1.{{.Kind}}{ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: testNamespace}}
	if err := crClient.Delete(ctx, cr); apierrors.IsNotFound(err) {
		return
	}
	waitFor{{.Kind}}GoneGenerated(ctx, crClient, name)
}

// new{{.Kind}}Generated returns a {{.Kind}} with the spec that the JSON holds.
func new{{.Kind}}Generated(name, spec string) *coralogixv1alpha1.{{.Kind}} {
	cr := &coralogixv1alpha1.{{.Kind}}{ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: testNamespace}}
	{{- range .E2E.Substitutions}}
	spec = strings.ReplaceAll(spec, {{printf "%q" .From}}, strings.ReplaceAll({{printf "%q" .To}}, "@{run}", name))
	{{- end}}
	{{- if .E2E.Env}}
	spec = expand{{.Kind}}Env(spec)
	{{- end}}
	decoder := json.NewDecoder(strings.NewReader(spec))
	decoder.DisallowUnknownFields()
	Expect(decoder.Decode(&cr.Spec)).To(Succeed())
{{- with .E2E.NameField}}
	cr.Spec.{{.}} = {{if $.E2E.NamePtr}}ptr.To(name){{else}}name{{end}}
{{- end}}
	return cr
}

{{if .E2E.Env}}// require{{.Kind}}Env skips the test when an environment variable that it reads is not set, and
// fails it in CI, where the workflow must set each one.
func require{{.Kind}}Env() {
	for _, name := range []string{ {{- range $i, $n := .E2E.Env}}{{if $i}}, {{end}}{{printf "%q" $n}}{{end -}} } {
		if os.Getenv(name) != "" {
			continue
		}
		if os.Getenv("CI") != "" {
			Fail(name + " is not set")
		}
		Skip(name + " is not set")
	}
}

// expand{{.Kind}}Env replaces each @{env.NAME} of a JSON spec with the value of the variable. The
// placeholder is inside a JSON string, so the value is escaped for it: a quote, a backslash, or a
// newline stays the exact character.
func expand{{.Kind}}Env(spec string) string {
	for _, name := range []string{ {{- range $i, $n := .E2E.Env}}{{if $i}}, {{end}}{{printf "%q" $n}}{{end -}} } {
		quoted, err := json.Marshal(os.Getenv(name))
		Expect(err).NotTo(HaveOccurred())
		spec = strings.ReplaceAll(spec, "@{env."+name+"}", string(quoted[1:len(quoted)-1]))
	}
	return spec
}

{{end}}// waitFor{{.Kind}}Generated waits until the {{.Kind}} is synced and has the fixed status id.
func waitFor{{.Kind}}Generated(ctx context.Context, crClient client.Client, name string) {
	Eventually(func(g Gomega) {
		cr := &coralogixv1alpha1.{{.Kind}}{}
		g.Expect(crClient.Get(ctx, types.NamespacedName{Name: name, Namespace: testNamespace}, cr)).To(Succeed())
		synced := meta.FindStatusCondition(cr.Status.Conditions, utils.ConditionTypeRemoteSynced)
		g.Expect(synced).NotTo(BeNil(), "{{.Kind}} %s has no RemoteSynced condition yet", name)
		g.Expect(synced.Status).To(Equal(metav1.ConditionTrue), "{{.Kind}} %s is not synced: %s: %s", name, synced.Reason, synced.Message)
		g.Expect(ptr.Deref(cr.Status.ID, "")).To(Equal({{printf "%q" .SingletonID}}))
	}, time.Minute, time.Second).Should(Succeed())
}

// waitFor{{.Kind}}GoneGenerated waits until the operator has removed the finalizer and the CR is gone.
func waitFor{{.Kind}}GoneGenerated(ctx context.Context, crClient client.Client, name string) {
	Eventually(func() bool {
		err := crClient.Get(ctx, types.NamespacedName{Name: name, Namespace: testNamespace}, &coralogixv1alpha1.{{.Kind}}{})
		return apierrors.IsNotFound(err)
	}, time.Minute, time.Second).Should(BeTrue())
}
