          "method": "POST",
          "path": "/recording-rules/recording-rules/v1",
          "body": {
            "name": "cxo-fidelity-rrgs-a-{{run}}",
            "groups": [
              {
                "name": "g1",
                "interval": 120,
                "limit": "7",
                "rules": [
                  {
                    "record": "cxo_fidelity_a1",
                    "expr": "vector(1)",
                    "labels": {
                      "team": "fidelity"
                    }
                  }
                ]
              },
              {
                "name": "g2",
                "rules": [
                  {
                    "record": "cxo_fidelity_a2",
