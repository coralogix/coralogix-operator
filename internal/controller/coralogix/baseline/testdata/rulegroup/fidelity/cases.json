    {
      "name": "create, get, replace, delete, and the missing group",
      "steps": [
        {
          "method": "POST",
          "path": "/parsing-rules/rule-groups/v1",
          "capture": "group",
          "body": {
            "name": "cxo-fidelity-rg-{{run}}",
            "ruleSubgroups": [
              {
                "order": 1,
                "rules": [
                  {
                    "name": "first",
                    "sourceField": "text",
                    "parameters": {
                      "extractParameters": {
                        "rule": "a(?P<b>\\d+)"
                      }
                    },
                    "order": 1,
                    "description": "First rule"
                  },
                  {
                    "name": "second",
                    "sourceField": "text",
                    "parameters": {
                      "parseParameters": {
                        "destinationField": "text",
                        "rule": "b(?P<c>\\d+)"
                      }
                    },
                    "order": 2
                  }
                ]
              },
              {
                "order": 2,
                "rules": [
                  {
                    "name": "third",
                    "sourceField": "text",
                    "parameters": {
                      "extractParameters": {
                        "rule": "c"
                      }
                    },
                    "order": 1,
                    "enabled": false
                  }
                ],
                "enabled": false
              }
            ],
            "description": "Control group",
            "creator": "cxo-fidelity",
            "enabled": true,
            "hidden": false,
            "order": 2,
            "ruleMatchers": [
              {
                "applicationName": {
                  "value": "cxo-app"
                }
              },
              {
                "subsystemName": {
                  "value": "cxo-sub"
                }
              },
              {
                "severity": {
                  "value": "VALUE_WARNING"
                }
              }
            ]
          }
        },
        {
          "method": "GET",
          "path": "/parsing-rules/rule-groups/v1/{{group}}"
        },
        {
          "method": "PUT",
          "path": "/parsing-rules/rule-groups/v1/{{group}}",
          "body": {
