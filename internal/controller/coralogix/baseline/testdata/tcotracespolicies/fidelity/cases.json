    {
      "name": "every field",
      "steps": [
        {
          "method": "PUT",
          "path": "/dataplans/span-policies/v1",
          "body": {
            "policies": [
              {
                "policy": {
                  "name": "cxo-fidelity-structured",
                  "description": "Structured rules",
                  "priority": "PRIORITY_TYPE_HIGH",
                  "disabled": true,
                  "applicationRule": {
                    "name": "prod,staging",
                    "ruleTypeId": "RULE_TYPE_ID_IS"
                  },
                  "subsystemRule": {
                    "name": "mobile",
                    "ruleTypeId": "RULE_TYPE_ID_IS_NOT"
                  },
                  "priorityOverride": {
                    "quotaBased": {
                      "usageTiers": [
                        {
                          "dailyQuotaPercentage": 30,
                          "priority": "PRIORITY_TYPE_MEDIUM"
                        },
                        {
                          "dailyQuotaPercentage": 60.5,
                          "priority": "PRIORITY_TYPE_LOW"
                        }
                      ]
                    }
                  }
                },
                "spanRules": {
                  "serviceRule": {
                    "name": "service,system",
                    "ruleTypeId": "RULE_TYPE_ID_INCLUDES"
                  },
                  "actionRule": {
                    "name": "action1,action2",
                    "ruleTypeId": "RULE_TYPE_ID_START_WITH"
                  },
                  "tagRules": [
                    {
                      "tagName": "tags.http",
                      "tagValue": "GET,POST",
                      "ruleTypeId": "RULE_TYPE_ID_IS"
                    },
                    {
                      "tagName": "tags.env",
                      "tagValue": "dev",
                      "ruleTypeId": "RULE_TYPE_ID_IS_NOT"
                    }
                  ]
                }
              },
              {
                "policy": {
                  "name": "cxo-fidelity-dpxl",
                  "description": "DPXL rules",
                  "priority": "PRIORITY_TYPE_MEDIUM",
                  "disabled": false
                },
                "spanRules": {
                  "dpxlExpression": "<v1> $d.status == 'ERROR'"
                }
              }
            ]
          }
        },
        {
          "method": "PUT",
          "path": "/dataplans/span-policies/v1",
          "body": {
            "policies": []
          }
        }
      ]
    },
