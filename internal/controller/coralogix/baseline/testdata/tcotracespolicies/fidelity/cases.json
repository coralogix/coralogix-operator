{
  "cases": [
    {
      "name": "overwrite one policy, the same list again, then an empty list",
      "steps": [
        {
          "method": "PUT",
          "path": "/dataplans/span-policies/v1",
          "body": {
            "policies": [
              {
                "policy": {
                  "name": "cxo-fidelity-a",
                  "description": "",
                  "priority": "PRIORITY_TYPE_HIGH"
                },
                "spanRules": {}
              }
            ]
          }
        },
        {
          "method": "PUT",
          "path": "/dataplans/span-policies/v1",
          "body": {
            "policies": [
              {
                "policy": {
                  "name": "cxo-fidelity-a",
                  "description": "",
                  "priority": "PRIORITY_TYPE_HIGH"
                },
                "spanRules": {}
              }
            ]
          }
        },
        {
          "method": "PUT",
          "path": "/dataplans/span-policies/v1",
          "body": {
            "policies": []
          }
        }
      ]
    },
