{
  "cases": [
    {
      "name": "create, read, replace, and delete a rule as the operator does",
      "steps": [
        {
          "method": "POST",
          "path": "/alerts/suppression-rules/v1",
          "body": {
            "alertSchedulerRule": {
              "name": "cxo-fidelity-{{run}}-crud",
              "description": "Baseline rule",
              "enabled": true,
              "filter": {
                "whatExpression": "source logs | filter true",
                "alertMetaLabels": {
                  "value": [
                    {
                      "key": "app",
                      "value": "cxo"
                    }
                  ]
                }
              },
              "schedule": {
                "scheduleOperation": "SCHEDULE_OPERATION_MUTE",
                "oneTime": {
                  "timeframe": {
                    "startTime": "2027-01-04T00:00:00.000",
                    "timezone": "UTC+0",
                    "endTime": "2027-01-05T00:00:00.000"
                  }
                }
              },
              "metaLabels": [
                {
                  "key": "team",
                  "value": "cxo"
                }
              ]
            }
          },
          "capture": "rule"
        },
        {
          "method": "GET",
          "path": "/alerts/suppression-rules/v1/{{rule}}"
        },
        {
          "method": "PUT",
          "path": "/alerts/suppression-rules/v1",
          "body": {
            "alertSchedulerRule": {
              "name": "cxo-fidelity-{{run}}-crud-renamed",
              "description": "",
              "enabled": false,
              "filter": {
                "whatExpression": "source logs | filter $d.app == 'x'",
                "alertMetaLabels": {
                  "value": [
                    {
                      "key": "env"
                    }
                  ]
                }
              },
              "schedule": {
                "scheduleOperation": "SCHEDULE_OPERATION_ACTIVATE",
                "recurring": {
                  "alwaysActive": {}
                }
              },
              "uniqueIdentifier": "{{rule}}"
            }
          }
        },
        {
          "method": "GET",
          "path": "/alerts/suppression-rules/v1/{{rule}}"
        },
        {
          "method": "DELETE",
          "path": "/alerts/suppression-rules/v1/{{rule}}"
        },
        {
          "method": "GET",
          "path": "/alerts/suppression-rules/v1/{{rule}}"
        },
        {
          "method": "DELETE",
          "path": "/alerts/suppression-rules/v1/{{rule}}"
        }
      ]
    },
