    {
      "name": "every field",
      "steps": [
        {
          "method": "PUT",
          "path": "/dataplans/rum-policies/v1",
          "body": {
            "policies": [
              {
                "policy": {
                  "name": "cxo-fidelity-structured",
                  "description": "Structured rules",
                  "priority": "PRIORITY_TYPE_HIGH",
                  "disabled": true,
                  "applicationRule": {
                    "name": "prod,staging",
                    "ruleTypeId": "RULE_TYPE_ID_IS"
                  },
                  "subsystemRule": {
                    "name": "mobile,web",
                    "ruleTypeId": "RULE_TYPE_ID_START_WITH"
                  },
                  "priorityOverride": {
                    "quotaBased": {
                      "usageTiers": [
                        {
                          "dailyQuotaPercentage": 30,
                          "priority": "PRIORITY_TYPE_MEDIUM"
                        },
                        {
                          "dailyQuotaPercentage": 60.5,
                          "priority": "PRIORITY_TYPE_LOW"
                        }
                      ]
                    }
                  }
                },
                "rumRules": {
                  "severities": [
                    "SEVERITY_DEBUG",
                    "SEVERITY_VERBOSE",
                    "SEVERITY_INFO",
                    "SEVERITY_WARNING",
                    "SEVERITY_ERROR",
                    "SEVERITY_CRITICAL"
                  ]
                }
              },
              {
                "policy": {
                  "name": "cxo-fidelity-dpxl",
                  "description": "DPXL rules",
                  "priority": "PRIORITY_TYPE_MEDIUM",
                  "disabled": false,
                  "applicationRule": {
                    "name": "prod",
                    "ruleTypeId": "RULE_TYPE_ID_INCLUDES"
                  }
                },
                "rumRules": {
                  "dpxlExpression": "<v1>$d.applicationname == 'prod'"
                }
              }
            ]
          }
        },
        {
          "method": "PUT",
          "path": "/dataplans/rum-policies/v1",
          "body": {
            "policies": []
          }
        }
      ]
    },
