{
  "cases": [
    {
      "name": "create, get, update as the released operator, switch arms, delete, then act on the deleted evaluation",
      "steps": [
        {
          "method": "POST",
          "path": "/ai/evaluations/v3",
          "body": {
            "application": "{{application}}",
            "subsystem": "{{subsystem}}",
            "target": "RESPONSE",
            "config": {
              "pii": {
                "categories": [
                  "EMAIL_ADDRESS",
                  "PHONE_NUMBER"
                ]
              }
            },
            "isEnabled": true,
            "threshold": 0.8
          },
          "capture": "id"
        },
        {
          "method": "GET",
          "path": "/ai/evaluations/v3/{{id}}"
        },
        {
          "method": "PATCH",
          "path": "/ai/evaluations/v3/{{id}}",
          "body": {
            "config": {
              "toxicity": {}
            },
            "isEnabled": false,
            "threshold": 0.5
          }
        },
        {
          "method": "PATCH",
          "path": "/ai/evaluations/v3/{{id}}",
          "body": {
            "application": "{{application}}",
            "subsystem": "{{subsystem}}",
            "target": "RESPONSE",
            "config": {
              "allowedTopics": {
                "topics": [
                  "billing"
                ]
              }
            },
            "isEnabled": true,
            "threshold": 0.4
          }
        },
        {
          "method": "PATCH",
          "path": "/ai/evaluations/v3/{{id}}",
          "body": {
            "config": {
              "promptInjection": {}
            },
            "isEnabled": true,
            "threshold": 0.4
          }
        },
        {
          "method": "GET",
          "path": "/ai/evaluations/v3/{{id}}"
        },
        {
          "method": "DELETE",
          "path": "/ai/evaluations/v3/{{id}}"
        },
        {
          "method": "GET",
          "path": "/ai/evaluations/v3/{{id}}"
        },
        {
          "method": "DELETE",
          "path": "/ai/evaluations/v3/{{id}}"
        },
        {
          "method": "PATCH",
          "path": "/ai/evaluations/v3/{{id}}",
          "body": {
            "isEnabled": true,
            "threshold": 0.3
          }
        }
      ]
    },
    {
      "name": "create with no isEnabled and no threshold",
      "steps": [
        {
          "method": "POST",
          "path": "/ai/evaluations/v3",
          "body": {
            "application": "{{application}}",
            "subsystem": "{{subsystem}}",
            "target": "PROMPT",
            "config": {
              "sexism": {}
            }
          },
          "capture": "id"
        },
        {
          "method": "GET",
          "path": "/ai/evaluations/v3/{{id}}"
        },
        {
          "method": "DELETE",
          "path": "/ai/evaluations/v3/{{id}}"
        }
      ]
    },
    {
      "name": "create a prompt injection for the response",
      "steps": [
        {
          "method": "POST",
          "path": "/ai/evaluations/v3",
          "body": {
            "application": "{{application}}",
            "subsystem": "{{subsystem}}",
            "target": "RESPONSE",
            "config": {
              "promptInjection": {
                "additionalContext": "a support assistant"
              }
            },
            "isEnabled": true,
            "threshold": 0.8
          },
          "capture": "id"
        },
        {
          "method": "DELETE",
          "path": "/ai/evaluations/v3/{{id}}"
        }
      ]
    },
    {
      "name": "create twice with the same application, subsystem, target, and type",
