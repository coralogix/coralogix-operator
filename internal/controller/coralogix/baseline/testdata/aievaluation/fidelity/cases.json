{
  "cases": [
    {
      "name": "create, get, update as the released operator, switch arms, delete, then act on the deleted evaluation",
      "steps": [
        {
          "method": "POST",
          "path": "/ai/evaluations/v3",
          "body": {
            "application": "{{application}}",
            "subsystem": "{{subsystem}}",
            "target": "RESPONSE",
            "config": {
              "pii": {
                "categories": [
                  "EMAIL_ADDRESS",
                  "PHONE_NUMBER"
                ]
              }
            },
            "isEnabled": true,
            "threshold": 0.8
          },
          "capture": "id"
        },
        {
          "method": "GET",
          "path": "/ai/evaluations/v3/{{id}}"
        },
        {
          "method": "PATCH",
          "path": "/ai/evaluations/v3/{{id}}",
          "body": {
            "config": {
              "toxicity": {}
            },
            "isEnabled": false,
            "threshold": 0.5
          }
        },
        {
          "method": "PATCH",
          "path": "/ai/evaluations/v3/{{id}}",
          "body": {
            "application": "{{application}}",
            "subsystem": "{{subsystem}}",
            "target": "RESPONSE",
            "config": {
              "allowedTopics": {
                "topics": [
                  "billing"
                ]
              }
            },
            "isEnabled": true,
            "threshold": 0.4
          }
        },
        {
          "method": "PATCH",
          "path": "/ai/evaluations/v3/{{id}}",
          "body": {
            "config": {
              "promptInjection": {}
            },
            "isEnabled": true,
            "threshold": 0.4
          }
        },
        {
          "method": "GET",
          "path": "/ai/evaluations/v3/{{id}}"
        },
        {
          "method": "DELETE",
          "path": "/ai/evaluations/v3/{{id}}"
        },
        {
          "method": "GET",
          "path": "/ai/evaluations/v3/{{id}}"
        },
        {
          "method": "DELETE",
          "path": "/ai/evaluations/v3/{{id}}"
        },
        {
          "method": "PATCH",
          "path": "/ai/evaluations/v3/{{id}}",
          "body": {
            "isEnabled": true,
            "threshold": 0.3
          }
        }
      ]
    },
