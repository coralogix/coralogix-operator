                },
                "logRules": {
                  "severities": [
                    "SEVERITY_INFO",
                    "SEVERITY_ERROR"
                  ]
                }
              }
            ]
          }
        },
        {
          "method": "PUT",
          "path": "/dataplans/log-policies/v1",
          "body": {
            "policies": []
          }
        }
      ]
