          "method": "PUT",
          "path": "/dataplans/log-policies/v1",
          "body": {
            "policies": [
              {
                "policy": {
                  "name": "cxo-fidelity-a",
                  "description": "",
                  "priority": "PRIORITY_TYPE_HIGH"
                },
                "logRules": {
                  "severities": [
                    "SEVERITY_INFO",
                    "SEVERITY_ERROR"
                  ]
                }
              }
            ]
          }
        },
        {
          "method": "PUT",
          "path": "/dataplans/log-policies/v1",
          "body": {
            "policies": [
              {
                "policy": {
                  "name": "cxo-fidelity-a",
                  "description": "",
