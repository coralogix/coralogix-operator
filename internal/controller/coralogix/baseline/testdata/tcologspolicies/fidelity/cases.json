    {
      "name": "every field",
      "steps": [
        {
          "method": "PUT",
          "path": "/dataplans/log-policies/v1",
          "body": {
            "policies": [
              {
                "policy": {
                  "name": "cxo-fidelity-structured",
                  "description": "Structured rules",
                  "priority": "PRIORITY_TYPE_HIGH",
                  "disabled": true,
                  "applicationRule": {
                    "name": "prod,staging",
                    "ruleTypeId": "RULE_TYPE_ID_IS"
                  },
                  "subsystemRule": {
                    "name": "mobile,web",
                    "ruleTypeId": "RULE_TYPE_ID_START_WITH"
                  },
                  "priorityOverride": {
                    "quotaBased": {
                      "usageTiers": [
                        {
                          "dailyQuotaPercentage": 30,
                          "priority": "PRIORITY_TYPE_MEDIUM"
                        },
                        {
                          "dailyQuotaPercentage": 60.5,
                          "priority": "PRIORITY_TYPE_LOW"
                        }
                      ]
                    }
                  }
                },
                "logRules": {
                  "severities": [
                    "SEVERITY_DEBUG",
                    "SEVERITY_VERBOSE",
                    "SEVERITY_INFO",
                    "SEVERITY_WARNING",
                    "SEVERITY_ERROR",
                    "SEVERITY_CRITICAL"
                  ]
                }
              },
              {
                "policy": {
                  "name": "cxo-fidelity-dpxl",
                  "description": "DPXL rules",
                  "priority": "PRIORITY_TYPE_MEDIUM",
                  "disabled": false
                },
                "logRules": {
                  "dpxlExpression": "<v1>$d.applicationname == 'prod'"
                }
              },
              {
                "policy": {
                  "name": "cxo-fidelity-targets",
                  "description": "",
                  "priority": "PRIORITY_TYPE_UNSPECIFIED",
                  "applicationRule": {
                    "name": "dev",
                    "ruleTypeId": "RULE_TYPE_ID_INCLUDES"
                  },
                  "subsystemRule": {
                    "name": "test",
                    "ruleTypeId": "RULE_TYPE_ID_IS_NOT"
                  },
                  "targets": [
                    {
                      "dataset": "logs",
                      "dataspace": "default",
                      "priority": "PRIORITY_TYPE_LOW"
                    },
                    {
                      "dataset": "logs",
                      "priority": "PRIORITY_TYPE_BLOCK",
                      "priorityOverride": {
                        "quotaBased": {
                          "usageTiers": [
                            {
                              "dailyQuotaPercentage": 60,
                              "priority": "PRIORITY_TYPE_MEDIUM"
                            }
                          ]
                        }
                      }
                    }
                  ]
                },
                "logRules": {
                  "severities": [
                    "SEVERITY_INFO"
                  ]
                }
              }
            ]
          }
        },
        {
          "method": "PUT",
          "path": "/dataplans/log-policies/v1",
          "body": {
            "policies": []
          }
        }
      ]
    },
