        "message": "Required value"
      }
    ]
  },
  "no policies field": {
    "accepted": false,
    "causes": [
      {
        "type": "FieldValueRequired",
        "field": "spec.policies",
        "message": "Required value"
      }
    ]
  },
  "no priority, no targets": {
    "accepted": true
  },
  "no subsystem names": {
    "accepted": false,
    "causes": [
      {
        "type": "FieldValueInvalid",
        "field": "spec.policies[0].subsystems.names",
        "message": "Invalid value: 0: spec.policies[0].subsystems.names in body should have at least 1 items"
      }
    ]
  },
  "override without usage tiers": {
    "accepted": false,
    "causes": [
      {
        "type": "FieldValueInvalid",
