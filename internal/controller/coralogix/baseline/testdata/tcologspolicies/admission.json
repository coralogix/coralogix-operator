      {
        "type": "FieldValueInvalid",
        "field": "spec.policies[0]",
        "message": "Invalid value: \"object\": dpxlExpression is mutually exclusive with severities, applications and subsystems"
      }
    ]
  },
  "dpxl expression and subsystems": {
    "accepted": false,
    "causes": [
      {
        "type": "FieldValueInvalid",
        "field": "spec.policies[0]",
        "message": "Invalid value: \"object\": dpxlExpression is mutually exclusive with severities, applications and subsystems"
      }
    ]
  },
  "empty dpxl expression": {
    "accepted": false,
