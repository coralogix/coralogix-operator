  "cases": [
    {
      "name": "generic: create, get, replace, clear on replace, delete, and the missing webhook",
      "steps": [
        {
          "method": "POST",
          "path": "/integrations/webhooks/v1",
          "body": {
            "data": {
              "name": "cxo-fidelity-webhook-{{run}}-generic",
              "type": "GENERIC",
              "url": "https://example.com/hook",
              "genericWebhook": {
                "uuid": "00000000-0000-4000-8000-000000000001",
                "method": "POST",
                "headers": {
                  "X-Team": "platform"
                },
                "payload": "{\"alert\":\"$ALERT_NAME\"}"
              }
            }
          },
          "capture": "webhook"
        },
        {
          "method": "GET",
          "path": "/integrations/webhooks/v1/{{webhook}}"
        },
        {
          "method": "PUT",
          "path": "/integrations/webhooks/v1",
          "body": {
            "id": "{{webhook}}",
            "data": {
              "name": "cxo-fidelity-webhook-{{run}}-generic-updated",
              "type": "GENERIC",
              "url": "https://example.com/hook-updated",
              "genericWebhook": {
                "uuid": "00000000-0000-4000-8000-000000000002",
                "method": "PUT"
              }
            }
          }
