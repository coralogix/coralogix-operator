{
  "cases": [
    {
      "name": "create with every field as the released operator, update, clear the examples, relink, delete, then act on the deleted custom evaluation",
      "steps": [
        {
          "method": "POST",
          "path": "/ai/custom-evaluations/v3",
          "body": {
            "name": "cxo-fidelity-{{run}}-full",
            "description": "Flags competitors.",
            "instructions": "Check whether {response} names a competitor.",
            "policyType": "quality",
            "safe": "Stays on our product.",
            "violates": "Names a competitor.",
            "shouldIncludeSystemPrompt": true,
            "examples": [
              {
                "conversation": "good one",
                "score": "1"
              },
              {
                "conversation": "bad one",
                "score": "0"
              }
            ],
            "applicationIds": [
              "{{applicationId}}"
            ]
          },
          "capture": "id"
        },
        {
          "method": "GET",
          "path": "/ai/custom-evaluations/v3"
        },
        {
          "method": "PATCH",
          "path": "/ai/custom-evaluations/v3/{{id}}",
          "body": {
            "name": "cxo-fidelity-{{run}}-renamed",
            "description": "",
            "instructions": "Check {prompt}.",
            "policyType": "security",
            "safe": "",
            "violates": "Leaks a secret.",
            "shouldIncludeSystemPrompt": false,
            "examples": [
              {
                "conversation": "good two",
                "score": "1"
              }
            ]
          }
        },
        {
          "method": "PATCH",
          "path": "/ai/custom-evaluations/v3/{{id}}",
          "body": {
            "name": "cxo-fidelity-{{run}}-renamed",
            "description": "",
            "instructions": "Check {prompt}.",
            "policyType": "security",
            "safe": "",
            "violates": "Leaks a secret.",
            "shouldIncludeSystemPrompt": false
          }
        },
        {
          "method": "PATCH",
          "path": "/ai/custom-evaluations/v3/{{id}}",
          "body": {
            "updateMask": "examples"
          }
        },
        {
          "method": "GET",
          "path": "/ai/custom-evaluations/v3"
        },
        {
          "method": "DELETE",
          "path": "/ai/custom-evaluations/v3/{{id}}/applications/{{applicationId}}"
